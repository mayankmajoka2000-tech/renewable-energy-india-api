# Copy to .env and fill in for Postgres deployment. Not needed for local
# SQLite use (app/database.py falls back to the bundled SQLite file if
# DATABASE_URL is unset).

# postgresql://<user>:<password>@<host>:<port>/<dbname>
# Matches the `postgres` service defaults in docker-compose.yml:
DATABASE_URL=postgresql://renewable:renewable@localhost:5432/renewable_energy_india
